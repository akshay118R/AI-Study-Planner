# Server Configuration
PORT=3000

# Local Ollama AI Configuration (100% Offline & Private)
# Ollama loopback base URL
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required Gemma model tag (pull via: ollama pull gemma4:2b)
OLLAMA_MODEL=gemma4:2b

# Generation timeout in milliseconds (default: 180000 = 3 minutes)
OLLAMA_TIMEOUT_MS=180000

# Sampling temperature (lower = more deterministic structured JSON)
OLLAMA_TEMPERATURE=0.2
